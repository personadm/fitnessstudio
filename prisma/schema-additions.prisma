// ─────────────────────────────────────────────────────────────────────
// C1 — Multi-Tenant Schema-Erweiterungen
// ─────────────────────────────────────────────────────────────────────
//
// Diese Snippets gehören in dein bestehendes `prisma/schema.prisma`.
// Sie sind ADDITIV — keine bestehenden Models werden überschrieben.
//
// Anweisung:
//   1. Block A (TenantStatus-Enum) — an die Stelle wo deine anderen Enums stehen
//   2. Block B (Tenant-Model) — am Ende deines Schemas
//   3. Block C (AdminUser-Erweiterung) — dein bestehendes AdminUser-Model
//      so anpassen wie unten beschrieben
//   4. Migrations-SQL ausführen (siehe migrations/001-tenant-setup.sql)
//   5. `prisma db push --accept-data-loss` läuft automatisch beim
//      nächsten Render-Deploy und legt die neuen Spalten an.
//
// ─────────────────────────────────────────────────────────────────────


// ═══════════════════════════════════════════════════════════════════════
// BLOCK A — Enum hinzufügen (bei deinen anderen Enums oben im Schema)
// ═══════════════════════════════════════════════════════════════════════

enum TenantStatus {
  ACTIVE      // normaler Betrieb
  TRIAL       // Test-Phase, automatische Sperrung nach Ablauf
  SUSPENDED   // manuell gesperrt (Zahlungsausfall, Vertragsbruch)
  CANCELLED   // Vertrag beendet, Daten werden 90 Tage aufbewahrt
}


// ═══════════════════════════════════════════════════════════════════════
// BLOCK B — Tenant-Model (am Ende deines Schemas einfügen)
// ═══════════════════════════════════════════════════════════════════════

model Tenant {
  id   String @id @default(cuid())
  // URL-freundlicher Bezeichner. Wird in Endkunden-URLs verwendet:
  //   gesundheitscoaches.app/<slug>/anmelden
  // Sollte unveränderbar sein nach Onboarding (sonst brechen Links).
  slug String @unique

  // Anzeige-Name des Studios (z.B. "Fitnessstudio Müller")
  name String

  // Status — siehe TenantStatus-Enum oben
  status TenantStatus @default(TRIAL)

  // Vertragsdaten (optional, kann später nachgepflegt werden)
  contactEmail   String?
  contactPhone   String?
  ustId          String?
  hrb            String?
  geschaeftsfuehrer String?

  // Branding (für späteren Step — bleibt erstmal null)
  logoUrl       String?
  primaryColor  String? // Hex-Code z.B. "#0F6E56"

  // Mail-Versand: alle Tenants nutzen aktuell die Default-Domain.
  // Später optional eigene Resend-Credentials möglich.
  customMailFrom    String?
  customMailReplyTo String?

  // Wann ist der Trial vorbei (NULL = unbefristet, z.B. für deine
  // eigenen Tenants "Deine Gesundheitscoaches")
  trialEndsAt DateTime?

  // Onboarding-Code-Trace: welcher Code wurde verwendet?
  // Wird beim Code-Verbrauch gesetzt, nur informational.
  onboardedViaCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations zu allen tenant-scoped Models — wird in Phase 2 erweitert.
  // Erstmal nur AdminUser:
  adminUsers AdminUser[]

  // Onboarding-Codes die für diesen Tenant verwendet wurden
  // (NULL = noch ungenutzte Codes)
  consumedCodes OnboardingCode[]

  @@index([status])
}

// Onboarding-Codes — Super-Admin (du) generiert sie, Studios verwenden
// sie im öffentlichen Onboarding-Flow um sich zu registrieren.
model OnboardingCode {
  id   String @id @default(cuid())
  code String @unique // z.B. "TIM-2026-A3B7K9" — case-insensitive lookup

  // Wenn null: Code ist noch nicht eingelöst.
  // Wenn gesetzt: Code wurde von diesem Tenant verbraucht.
  consumedByTenantId String?
  consumedByTenant   Tenant?  @relation(fields: [consumedByTenantId], references: [id], onDelete: SetNull)
  consumedAt         DateTime?

  // Info für dich: für welchen Use-Case dieser Code gedacht ist
  // (z.B. "Fitnessstudio Müller, Vertrag ab 01.07.2026")
  note String?

  // Optional: Code-Ablauf (kann null sein für unbefristet)
  expiresAt DateTime?

  // Optional: vordefinierte Trial-Länge in Tagen für den neuen Tenant
  // (null = Standard von 30 Tagen)
  trialDurationDays Int?

  createdAt DateTime @default(now())

  @@index([consumedByTenantId])
}


// ═══════════════════════════════════════════════════════════════════════
// BLOCK C — AdminUser-Erweiterung (dein bestehendes AdminUser-Model
//                                   so abändern)
// ═══════════════════════════════════════════════════════════════════════
//
// VORHER (aktueller Stand laut Mai-Schema):
//
//   model AdminUser {
//     id           String   @id @default(cuid())
//     email        String   @unique
//     passwordHash String
//     name         String?
//     createdAt    DateTime @default(now())
//   }
//
// NACHHER:
//
//   model AdminUser {
//     id           String   @id @default(cuid())
//     email        String   @unique  // bleibt @unique GLOBAL — siehe Hinweis unten
//     passwordHash String
//     name         String?
//     createdAt    DateTime @default(now())
//
//     // ─── NEU für Multi-Tenant ───
//     // tenantId NULL = Super-Admin (du), hat Zugriff auf alle Tenants.
//     // tenantId gesetzt = normaler Studio-Admin, scoped auf den Tenant.
//     tenantId   String?
//     tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
//     superAdmin Boolean  @default(false)
//
//     @@index([tenantId])
//   }
//
// ENTSCHEIDUNG zu E-Mail-Uniqueness:
// E-Mail bleibt GLOBAL unique. Wenn jemand bei Studio Müller "tim@example.com"
// registriert, kann derselbe Mensch nicht parallel bei Studio Schmidt einen
// Account mit derselben Mail haben. Begründung:
//   - Mail-basierte Logik (Login, Reset, Auth) wird sonst kompliziert
//   - Realistisch braucht jemand selten Konten in mehreren Studios
//   - Falls doch mal nötig: kann manuell mit Alias-Mail gelöst werden
// Alternativ wäre @@unique([email, tenantId]) — komplexer aber technisch
// möglich. Sag Bescheid wenn du das brauchst, dann passen wir's an.
