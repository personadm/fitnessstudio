// ─────────────────────────────────────────────────────────────────────
// HYBRID-MODUS für FunnelStep — Schema-Erweiterung
// ─────────────────────────────────────────────────────────────────────
//
// In dein bestehendes `prisma/schema.prisma` einfügen:
//
// → Such dein "model FunnelStep" und füge die drei Felder mit *** markiert ein.
//
// Die Funnel-weiten Felder (`scheduleWeekday`, `scheduleWeekInterval`,
// `scheduleHour`, `scheduleMinute`) bleiben unverändert — werden ab jetzt
// nur noch als "Default-Werte für neue Steps" verwendet. Die echte
// Sende-Logik schaut auf die Step-Felder unten.
//
// ─────────────────────────────────────────────────────────────────────

model FunnelStep {
  id        String   @id @default(cuid())
  funnelId  String
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  orderNum  Int
  delayDays Int
  delayHours Int     @default(0)
  subject   String
  bodyHtml  String
  createdAt DateTime @default(now())

  // *** NEU: Hybrid-Modus pro Step ***
  // Wenn scheduleWeekday gesetzt: Step ist HYBRID.
  //   → frühestens nach delayDays + delayHours, dann nächster Wochentag X um Y Uhr.
  // Wenn scheduleWeekday NULL: Step ist KLASSISCH (= aktueller Modus).
  //   → genau nach delayDays + delayHours.
  //
  // Wochentag: 0=Sonntag, 1=Montag, ..., 6=Samstag
  scheduleWeekday Int?
  scheduleHour    Int?
  scheduleMinute  Int?
  // *** ENDE NEU ***

  events FunnelStepEvent[]

  @@unique([funnelId, orderNum])
  @@index([funnelId])
}
