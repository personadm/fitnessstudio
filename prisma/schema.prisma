// Prisma Schema — Multi-Location Phase 2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direkte Verbindung (Port 5432) für Migrationen/db push.
  // Der Transaction-Pooler (6543, pgbouncer) hängt bei DDL.
  // Fällt auf DATABASE_URL zurück, falls DIRECT_URL nicht gesetzt ist.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum ContactStatus {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

enum ContactSource {
  LANDING
  DIRECT
  MANUAL
  IMPORT
  CLUB_OFFLINE
  CLUB_ONLINE
}

enum BillingInterval {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
  EINMALIG
}

enum Gender {
  MAENNLICH
  WEIBLICH
  DIVERS
}

enum FunnelTrigger {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

// ─────────────────────────────────────────────────────────────
// LOCATION
// ─────────────────────────────────────────────────────────────

model Location {
  id         String   @id @default(cuid())
  name       String
  street     String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contacts          Contact[]
  plans             PricingPlan[]
  funnels           Funnel[]
  targetedCampaigns Campaign[]

  @@index([active, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// CONTACT
// ─────────────────────────────────────────────────────────────

model Contact {
  id        String    @id @default(cuid())
  email     String    @unique
  firstName String?
  lastName  String?
  gender    Gender?
  phone     String?
  birthDate DateTime? @db.Date

  status ContactStatus @default(INTERESSENT)
  source ContactSource @default(LANDING)

  street     String?
  postalCode String?
  city       String?

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  doiToken       String?   @unique
  doiSentAt      DateTime?
  doiConfirmedAt DateTime?

  consentText String?
  consentIp   String?

  refToken String? @unique

  pricingPlanId     String?
  pricingPlan       PricingPlan? @relation(fields: [pricingPlanId], references: [id])
  memberSince       DateTime?
  memberUntil       DateTime?
  iban              String?
  contractStartDate DateTime?    @db.Date
  signupAt          DateTime?
  signupStaff       String? // Name des Mitarbeiters bei Club-Anmeldung

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists             ContactList[]
  events            ContactEvent[]
  funnelEnrollments FunnelEnrollment[]

  // Abmeldung (Newsletter-Opt-out)
  // unsubscribeToken: bei neuen Kontakten via @default(cuid()) automatisch erzeugt.
  // Bestehende Kontakte haben hier null und bekommen ihren Token erst beim
  // nächsten Mail-Versand (Backfill in src/lib/funnels.ts).
  unsubscribeToken String?   @unique @default(cuid())
  optedOutAt       DateTime?

  // Nur-Newsletter-Kontakte: bekommen ausschließlich Listen-Kampagnen (z.B. den
  // Sonntags-Newsletter), werden aber NICHT in Funnels eingeschrieben und NICHT
  // von status-basierten Kampagnen erfasst. Gesetzt z.B. beim Excel-Import mit
  // aktivierter "Nur Sonntags-Newsletter"-Option.
  newsletterOnly Boolean @default(false)

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([signupAt])
  @@index([locationId])
  @@index([status, locationId])
  @@index([optedOutAt])
  @@index([pricingPlanId])
  @@index([doiConfirmedAt])
}

// ─────────────────────────────────────────────────────────────
// PRICING PLANS
// ─────────────────────────────────────────────────────────────

model PricingPlan {
  id               String          @id @default(cuid())
  name             String
  description      String?
  priceCents       Int
  billingInterval  BillingInterval @default(MONATLICH)
  highlights       String[]
  // Bis zu 3 hervorgehobene Vorteile fürs Anmeldeseiten-Hero
  // Format: [{ "text": "...", "subtitle": "...", "isGold": false }, ...]
  topHighlights    Json            @default("[]")
  agb              String? // Tarif-spezifischer AGB-Text, wird auf Anmeldeseite gezeigt
  availableOnline  Boolean         @default(true) // Sichtbar im Online-Formular /anmelden
  availableOffline Boolean         @default(true) // Sichtbar im Club-Formular /admin/club-anmeldung
  active           Boolean         @default(true)
  sortOrder        Int             @default(0)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  @@index([locationId, active])
}

// ─────────────────────────────────────────────────────────────
// LISTS & CAMPAIGNS
// ─────────────────────────────────────────────────────────────

model List {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  contacts  ContactList[]
  campaigns Campaign[]
}

model ContactList {
  contactId String
  listId    String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
  @@index([listId])
}

model Campaign {
  id String @id @default(cuid())

  // Empfänger-Targeting: ENTWEDER listId ODER targetStatus muss gesetzt sein.
  // targetLocationId schränkt die Empfänger zusätzlich auf einen Standort ein.
  listId           String?
  list             List?          @relation(fields: [listId], references: [id], onDelete: SetNull)
  targetStatus     ContactStatus?
  targetLocationId String?
  targetLocation   Location?      @relation(fields: [targetLocationId], references: [id], onDelete: SetNull)

  subject     String
  bodyHtml    String
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())

  // Zeitpunkt, an dem dieser Versand auf SENDING gesetzt wurde. Dient dem
  // Cron-Sicherheitsnetz: NUR kürzlich gestartete (unterbrochene) Sends werden
  // fortgesetzt — eine alt-hängende SENDING-Kampagne wird nie wieder
  // stillschweigend reaktiviert.
  sendingStartedAt DateTime?

  events CampaignEvent[]

  @@index([targetStatus, targetLocationId])
  @@index([listId])
  @@index([status, scheduledAt])
}

model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  event      String
  meta       Json?
  createdAt  DateTime @default(now())

  @@unique([campaignId, contactId, event])
  @@index([campaignId, event])
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// FUNNELS
// ─────────────────────────────────────────────────────────────

model Funnel {
  id       String        @id @default(cuid())
  name     String
  trigger  FunnelTrigger
  active   Boolean       @default(true)
  autoStop Boolean       @default(true)

  // Standort-Filter: wenn gesetzt, nur Kontakte an diesem Standort
  // werden eingeschrieben. null = alle Standorte (Default).
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Wochenplan-Modus: wenn scheduleWeekday gesetzt, werden Schritte
  // nicht nach delayDays/delayHours berechnet, sondern nach Wochenplan:
  // jeder Schritt fällig am Wochentag X, alle Y Wochen, um Z Uhr.
  // 0=So, 1=Mo, 2=Di, 3=Mi, 4=Do, 5=Fr, 6=Sa (entspricht JS Date.getDay())
  scheduleWeekday      Int?
  scheduleWeekInterval Int  @default(1)
  scheduleHour         Int  @default(9)
  scheduleMinute       Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       FunnelStep[]
  enrollments FunnelEnrollment[]

  @@index([trigger, active])
  @@index([locationId])
}

model FunnelStep {
  id         String   @id @default(cuid())
  funnelId   String
  funnel     Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  orderNum   Int
  delayDays  Int
  delayHours Int      @default(0)
  subject    String
  bodyHtml   String
  createdAt  DateTime @default(now())

  // Hybrid-Schedule (optional pro Step): siehe calculateDueAt in src/lib/funnels.ts
  scheduleWeekday Int?
  scheduleHour    Int?
  scheduleMinute  Int?

  events FunnelStepEvent[]

  @@unique([funnelId, orderNum])
  @@index([funnelId])
}

model FunnelEnrollment {
  id           String    @id @default(cuid())
  funnelId     String
  funnel       Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  events FunnelStepEvent[]

  @@unique([funnelId, contactId])
  @@index([completedAt, cancelledAt])
}

model FunnelStepEvent {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   FunnelEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         FunnelStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentAt       DateTime         @default(now())
  // true = Marker für einen übersprungenen Step (Mail wurde NICHT verschickt,
  // nur als verarbeitet markiert). Steuert, dass der Activity-Feed Skip-Marker
  // nicht als echten Mailversand anzeigt.
  skipped      Boolean          @default(false)

  @@unique([enrollmentId, stepId])
  @@index([stepId])
}

// ─────────────────────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS / TRACKING
// ─────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────
// KI-WISSENSBASIS (E-Mail-Marketing aus YouTube-Transkripten)
// ─────────────────────────────────────────────────────────────

// Verarbeitungs-Status eines Quell-Videos. Lineare Pipeline:
// NEW → (Transkript) → TRANSCRIBED → (Klassifizierung) → RELEVANT/IRRELEVANT
//   → (Destillierung, nur RELEVANT) → DISTILLED
// Sackgassen: NO_TRANSCRIPT (kein Untertitel verfügbar), ERROR.
enum KnowledgeVideoStatus {
  NEW
  TRANSCRIBED
  RELEVANT
  IRRELEVANT
  DISTILLED
  NO_TRANSCRIPT
  ERROR
}

// Ein einzelnes Quell-Video (z.B. von Alex Hormozis Kanal).
model KnowledgeVideo {
  id          String               @id @default(cuid())
  youtubeId   String               @unique
  channelId   String
  title       String
  description  String?
  url         String
  publishedAt DateTime?

  status      KnowledgeVideoStatus @default(NEW)
  // Volltext-Transkript (kann groß sein). Null bis abgerufen.
  transcript  String?
  // Per-Video destillierte E-Mail-Marketing-Erkenntnisse (Markdown).
  distilledNotes String?
  // Letzter Fehlertext (für ERROR-Status / Debugging).
  error       String?

  discoveredAt DateTime  @default(now())
  processedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([channelId, publishedAt])
}

// Singleton-Dokument: aggregierte, destillierte Frameworks, die in die
// KI-Prompts injiziert werden. id ist fix "email-marketing".
model KnowledgeBase {
  id          String   @id
  // Aggregierter Frameworks-Text (Markdown), wird in System-Prompts injiziert.
  content     String   @default("")
  // Anzahl Videos, die in die aktuelle content-Version eingeflossen sind.
  videoCount  Int      @default(0)
  // Gate für den täglichen Sync (1×/24h) — persistent, überlebt Neustarts.
  lastSyncAt  DateTime?
  // Cursor für den Voll-Backfill der Alt-Videos (youtubei.js Continuation).
  backfillDone Boolean @default(false)
  updatedAt   DateTime @updatedAt
}
