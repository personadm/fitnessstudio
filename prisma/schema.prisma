// Prisma Schema — Multi-Location Phase 2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direkte Verbindung (Port 5432) für Migrationen/db push.
  // Der Transaction-Pooler (6543, pgbouncer) hängt bei DDL.
  // Fällt auf DATABASE_URL zurück, falls DIRECT_URL nicht gesetzt ist.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum ContactStatus {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

enum ContactSource {
  LANDING
  DIRECT
  MANUAL
  IMPORT
  CLUB_OFFLINE
  CLUB_ONLINE
}

enum BillingInterval {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
  EINMALIG
}

enum Gender {
  MAENNLICH
  WEIBLICH
  DIVERS
}

enum FunnelTrigger {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

// Multi-Tenant: Status eines Studios (Mandant)
enum StudioStatus {
  ONBOARDING // Code eingelöst, Onboarding-Wizard noch nicht abgeschlossen
  ACTIVE // Live geschaltet
  SUSPENDED // Gesperrt (z. B. Zahlungsausfall / manuell)
}

// Multi-Tenant: Status eines Aktivierungs-Codes
enum ActivationCodeStatus {
  UNUSED // generiert, noch nicht eingelöst
  REDEEMED // eingelöst → Studio erzeugt
  REVOKED // von dir gesperrt
}

// ─────────────────────────────────────────────────────────────
// MULTI-TENANT: STUDIO (Mandant) + AKTIVIERUNGS-CODES + PLATFORM-ADMIN
// ─────────────────────────────────────────────────────────────

// Ein Studio = ein Mandant. Erkannt an der Subdomain (slug).
// Alle mandanten-bezogenen Daten verweisen über studioId hierauf.
model Studio {
  id     String       @id @default(cuid())
  slug   String       @unique // Subdomain: <slug>.app.de
  name   String
  status StudioStatus @default(ONBOARDING)

  // Branding (ersetzt schrittweise die STUDIO_*-ENV-Variablen, Phase 5)
  logoUrl      String? @db.Text // Data-URL (hochgeladenes Logo) oder externe URL
  primaryColor String? // Haupt-/Markenfarbe (Hex), z. B. Petrol
  accentColor  String? // Akzentfarbe (Hex)
  paletteKey   String? // Schlüssel der gewählten Farb-Palette (siehe lib/palettes.ts)
  customDomain String? @unique // optionale eigene Domain (späteres Upgrade)

  // Landingpage-Inhalte (im Onboarding ggf. per KI aus der alten Website erzeugt).
  // Form: { headline, subheadline, intro, benefits: [{title,text}], aboutTitle,
  //         aboutText, ctaLabel } — siehe src/lib/landing.ts
  landingContent Json?

  // E-Mail-Absender pro Studio (ersetzt MAIL_FROM aus ENV)
  mailFromName  String?
  mailFromEmail String?
  mailReplyTo   String?

  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  locations      Location[]
  contacts       Contact[]
  plans          PricingPlan[]
  lists          List[]
  campaigns      Campaign[]
  funnels        Funnel[]
  adminUsers     AdminUser[]
  activationCode ActivationCode?

  @@index([status])
}

// Die Codes, die DU im Platform-Backend generierst und an Studios verkaufst.
// Ein Code = eine einmalige Aktivierung = ein Studio-Account.
model ActivationCode {
  id        String               @id @default(cuid())
  code      String               @unique // der Code zum Einlösen
  label     String? // interne Notiz, z. B. Kundenname / Verkaufsdatum
  status    ActivationCodeStatus @default(UNUSED)
  expiresAt DateTime? // optionales Ablaufdatum

  // Gesetzt, sobald der Code im Onboarding eingelöst wurde.
  studioId String? @unique
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
}

// Plattform-Betreiber (DU). Komplett getrennt von Studio-AdminUsern.
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// LOCATION
// ─────────────────────────────────────────────────────────────

model Location {
  id         String   @id @default(cuid())
  name       String
  street     String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  contacts          Contact[]
  plans             PricingPlan[]
  funnels           Funnel[]
  targetedCampaigns Campaign[]

  @@index([active, sortOrder])
  @@index([studioId])
}

// ─────────────────────────────────────────────────────────────
// CONTACT
// ─────────────────────────────────────────────────────────────

model Contact {
  id        String    @id @default(cuid())
  // E-Mail ist pro Studio eindeutig (siehe @@unique unten), nicht global.
  email     String
  firstName String?
  lastName  String?
  gender    Gender?
  phone     String?
  birthDate DateTime? @db.Date

  status ContactStatus @default(INTERESSENT)
  source ContactSource @default(LANDING)

  street     String?
  postalCode String?
  city       String?

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  doiToken       String?   @unique
  doiSentAt      DateTime?
  doiConfirmedAt DateTime?

  consentText String?
  consentIp   String?

  refToken String? @unique

  pricingPlanId     String?
  pricingPlan       PricingPlan? @relation(fields: [pricingPlanId], references: [id])
  memberSince       DateTime?
  memberUntil       DateTime?
  iban              String?
  contractStartDate DateTime?    @db.Date
  signupAt          DateTime?
  signupStaff       String? // Name des Mitarbeiters bei Club-Anmeldung

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists             ContactList[]
  events            ContactEvent[]
  funnelEnrollments FunnelEnrollment[]

  // Abmeldung (Newsletter-Opt-out)
  // unsubscribeToken: bei neuen Kontakten via @default(cuid()) automatisch erzeugt.
  // Bestehende Kontakte haben hier null und bekommen ihren Token erst beim
  // nächsten Mail-Versand (Backfill in src/lib/funnels.ts).
  unsubscribeToken String?   @unique @default(cuid())
  optedOutAt       DateTime?

  @@unique([studioId, email])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([signupAt])
  @@index([locationId])
  @@index([status, locationId])
  @@index([optedOutAt])
  @@index([pricingPlanId])
  @@index([doiConfirmedAt])
  @@index([studioId])
  @@index([studioId, status])
}

// ─────────────────────────────────────────────────────────────
// PRICING PLANS
// ─────────────────────────────────────────────────────────────

model PricingPlan {
  id               String          @id @default(cuid())
  name             String
  description      String?
  priceCents       Int
  billingInterval  BillingInterval @default(MONATLICH)
  highlights       String[]
  // Bis zu 3 hervorgehobene Vorteile fürs Anmeldeseiten-Hero
  // Format: [{ "text": "...", "subtitle": "...", "isGold": false }, ...]
  topHighlights    Json            @default("[]")
  agb              String? // Tarif-spezifischer AGB-Text, wird auf Anmeldeseite gezeigt
  availableOnline  Boolean         @default(true) // Sichtbar im Online-Formular /anmelden
  availableOffline Boolean         @default(true) // Sichtbar im Club-Formular /admin/club-anmeldung
  active           Boolean         @default(true)
  sortOrder        Int             @default(0)

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  @@index([locationId, active])
  @@index([studioId, active])
}

// ─────────────────────────────────────────────────────────────
// LISTS & CAMPAIGNS
// ─────────────────────────────────────────────────────────────

model List {
  id          String   @id @default(cuid())
  // Name ist pro Studio eindeutig (siehe @@unique unten), nicht global.
  name        String
  description String?
  createdAt   DateTime @default(now())

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  contacts  ContactList[]
  campaigns Campaign[]

  @@unique([studioId, name])
  @@index([studioId])
}

model ContactList {
  contactId String
  listId    String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
  @@index([listId])
}

model Campaign {
  id String @id @default(cuid())

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // Empfänger-Targeting: ENTWEDER listId ODER targetStatus muss gesetzt sein.
  // targetLocationId schränkt die Empfänger zusätzlich auf einen Standort ein.
  listId           String?
  list             List?          @relation(fields: [listId], references: [id], onDelete: SetNull)
  targetStatus     ContactStatus?
  targetLocationId String?
  targetLocation   Location?      @relation(fields: [targetLocationId], references: [id], onDelete: SetNull)

  subject     String
  bodyHtml    String
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())

  events CampaignEvent[]

  @@index([targetStatus, targetLocationId])
  @@index([listId])
  @@index([status, scheduledAt])
  @@index([studioId])
}

model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  event      String
  meta       Json?
  createdAt  DateTime @default(now())

  @@unique([campaignId, contactId, event])
  @@index([campaignId, event])
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// FUNNELS
// ─────────────────────────────────────────────────────────────

model Funnel {
  id       String        @id @default(cuid())
  name     String
  trigger  FunnelTrigger
  active   Boolean       @default(true)
  autoStop Boolean       @default(true)

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // Standort-Filter: wenn gesetzt, nur Kontakte an diesem Standort
  // werden eingeschrieben. null = alle Standorte (Default).
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Wochenplan-Modus: wenn scheduleWeekday gesetzt, werden Schritte
  // nicht nach delayDays/delayHours berechnet, sondern nach Wochenplan:
  // jeder Schritt fällig am Wochentag X, alle Y Wochen, um Z Uhr.
  // 0=So, 1=Mo, 2=Di, 3=Mi, 4=Do, 5=Fr, 6=Sa (entspricht JS Date.getDay())
  scheduleWeekday      Int?
  scheduleWeekInterval Int  @default(1)
  scheduleHour         Int  @default(9)
  scheduleMinute       Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       FunnelStep[]
  enrollments FunnelEnrollment[]

  @@index([trigger, active])
  @@index([locationId])
  @@index([studioId, trigger, active])
}

model FunnelStep {
  id         String   @id @default(cuid())
  funnelId   String
  funnel     Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  orderNum   Int
  delayDays  Int
  delayHours Int      @default(0)
  subject    String
  bodyHtml   String
  createdAt  DateTime @default(now())

  // Hybrid-Schedule (optional pro Step): siehe calculateDueAt in src/lib/funnels.ts
  scheduleWeekday Int?
  scheduleHour    Int?
  scheduleMinute  Int?

  events FunnelStepEvent[]

  @@unique([funnelId, orderNum])
  @@index([funnelId])
}

model FunnelEnrollment {
  id           String    @id @default(cuid())
  funnelId     String
  funnel       Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  events FunnelStepEvent[]

  @@unique([funnelId, contactId])
  @@index([completedAt, cancelledAt])
}

model FunnelStepEvent {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   FunnelEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         FunnelStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentAt       DateTime         @default(now())

  @@unique([enrollmentId, stepId])
  @@index([stepId])
}

// ─────────────────────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  // E-Mail ist pro Studio eindeutig (siehe @@unique unten), nicht global —
  // dieselbe Person kann bei mehreren Studios Admin sein.
  email        String
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  // Multi-Tenant
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, email])
  @@index([studioId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS / TRACKING
// ─────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  sessionId String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId])
}
