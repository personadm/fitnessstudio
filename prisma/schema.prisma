// Prisma Schema - Fitnessstudio App (Phase 6)
// Referenz: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum ContactStatus {
  INTERESSENT // Mail eingetragen, ggf. noch nicht DOI-bestätigt
  NEUKUNDE    // hat sich angemeldet, Vertrag in Vorbereitung
  KUNDE       // aktives Mitglied
  EHEMALIGER  // gekündigt / ausgelaufen
}

enum ContactSource {
  LANDING // Landing Page (nur Mail)
  DIRECT  // direkter Anmelde-Flow
  MANUAL  // vom Admin händisch angelegt
  IMPORT  // aus CSV / Altsystem importiert
}

enum BillingInterval {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
}

// Phase 6
enum Gender {
  MAENNLICH
  WEIBLICH
  DIVERS
}

// Phase 6
enum FunnelTrigger {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

// ─────────────────────────────────────────────────────────────
// CONTACT - der zentrale Datensatz
// ─────────────────────────────────────────────────────────────

model Contact {
  id        String        @id @default(cuid())
  email     String        @unique
  firstName String?
  lastName  String?
  gender    Gender? // Phase 6
  phone     String?
  birthDate DateTime?     @db.Date

  status ContactStatus @default(INTERESSENT)
  source ContactSource @default(LANDING)

  // Adresse (optional, später für Mitgliedsanmeldung)
  street     String?
  postalCode String?
  city       String?

  // Double-Opt-In
  doiToken       String?   @unique
  doiSentAt      DateTime?
  doiConfirmedAt DateTime?

  // Consent-Logging (DSGVO)
  consentText String? // Wortlaut der Einwilligung
  consentIp   String?

  // Tracking: welcher Lead hat sich tatsächlich angemeldet?
  refToken String? @unique

  // Mitgliedschaft
  pricingPlanId     String?
  pricingPlan       PricingPlan? @relation(fields: [pricingPlanId], references: [id])
  memberSince       DateTime?
  memberUntil       DateTime?
  iban              String? // Phase 6
  contractStartDate DateTime?    @db.Date // Phase 6
  signupAt          DateTime? // Phase 6 - wann das Anmeldeformular abgeschickt wurde

  // Sonstiges
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists             ContactList[]
  events            ContactEvent[]
  funnelEnrollments FunnelEnrollment[]

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([signupAt])
}

// ─────────────────────────────────────────────────────────────
// PRICING PLANS - im Admin pflegbar, fließen in Preis-Mail ein
// ─────────────────────────────────────────────────────────────

model PricingPlan {
  id              String          @id @default(cuid())
  name            String
  description     String?
  priceCents      Int
  billingInterval BillingInterval @default(MONATLICH)
  highlights      String[]
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
}

// ─────────────────────────────────────────────────────────────
// LISTS & CAMPAIGNS - Newsletter-Versand
// ─────────────────────────────────────────────────────────────

model List {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  contacts  ContactList[]
  campaigns Campaign[]
}

model ContactList {
  contactId String
  listId    String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
}

model Campaign {
  id          String    @id @default(cuid())
  listId      String
  list        List      @relation(fields: [listId], references: [id])
  subject     String
  bodyHtml    String
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())

  events CampaignEvent[]
}

model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  event      String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([campaignId, event])
}

// ─────────────────────────────────────────────────────────────
// AUDIT - was ist mit einem Kontakt passiert?
// ─────────────────────────────────────────────────────────────

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// FUNNELS - automatisierte Mail-Sequenzen (Phase 6)
// ─────────────────────────────────────────────────────────────

model Funnel {
  id        String        @id @default(cuid())
  name      String
  trigger   FunnelTrigger
  active    Boolean       @default(true)
  // Wenn true: Enrollment wird abgebrochen, sobald der Kontakt
  // den Trigger-Status wieder verlässt (z.B. EHEMALIGER -> KUNDE
  // stoppt den Win-Back-Funnel automatisch).
  autoStop  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  steps       FunnelStep[]
  enrollments FunnelEnrollment[]

  @@index([trigger, active])
}

model FunnelStep {
  id        String   @id @default(cuid())
  funnelId  String
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  orderNum  Int // 1, 2, 3 ...
  delayDays Int // Wartezeit in Tagen ab Eintragung in den Funnel
  subject   String
  bodyHtml  String
  createdAt DateTime @default(now())

  events FunnelStepEvent[]

  @@unique([funnelId, orderNum])
  @@index([funnelId])
}

model FunnelEnrollment {
  id           String    @id @default(cuid())
  funnelId     String
  funnel       Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String? // "STATUS_CHANGED" | "MANUAL"

  events FunnelStepEvent[]

  // Jeder Kontakt durchläuft jeden Funnel max. einmal.
  // (Wenn du das willst, kannst du das später ändern.)
  @@unique([funnelId, contactId])
  @@index([completedAt, cancelledAt])
}

model FunnelStepEvent {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   FunnelEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         FunnelStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentAt       DateTime         @default(now())

  @@unique([enrollmentId, stepId])
}

// ─────────────────────────────────────────────────────────────
// ADMIN - wer darf ins Dashboard?
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
