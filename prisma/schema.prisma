// Prisma Schema - Fitnessstudio App (Phase 6 + Multi-Location)
// Referenz: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum ContactStatus {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

enum ContactSource {
  LANDING
  DIRECT
  MANUAL
  IMPORT
}

enum BillingInterval {
  MONATLICH
  QUARTALSWEISE
  HALBJAEHRLICH
  JAEHRLICH
}

enum Gender {
  MAENNLICH
  WEIBLICH
  DIVERS
}

enum FunnelTrigger {
  INTERESSENT
  NEUKUNDE
  KUNDE
  EHEMALIGER
}

// ─────────────────────────────────────────────────────────────
// LOCATION (Standort) — neu für Multi-Location
// ─────────────────────────────────────────────────────────────

model Location {
  id         String   @id @default(cuid())
  name       String // z.B. "Studio Bochum", "Vital-Fit Ochtrup"
  street     String?
  postalCode String?
  city       String?
  phone      String?
  email      String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contacts Contact[]
  plans    PricingPlan[]

  @@index([active, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// CONTACT
// ─────────────────────────────────────────────────────────────

model Contact {
  id        String        @id @default(cuid())
  email     String        @unique
  firstName String?
  lastName  String?
  gender    Gender?
  phone     String?
  birthDate DateTime?     @db.Date

  status ContactStatus @default(INTERESSENT)
  source ContactSource @default(LANDING)

  street     String?
  postalCode String?
  city       String?

  // Multi-Location: welcher Standort?
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // DOI
  doiToken       String?   @unique
  doiSentAt      DateTime?
  doiConfirmedAt DateTime?

  consentText String?
  consentIp   String?

  refToken String? @unique

  pricingPlanId     String?
  pricingPlan       PricingPlan? @relation(fields: [pricingPlanId], references: [id])
  memberSince       DateTime?
  memberUntil       DateTime?
  iban              String?
  contractStartDate DateTime?    @db.Date
  signupAt          DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lists             ContactList[]
  events            ContactEvent[]
  funnelEnrollments FunnelEnrollment[]

  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([signupAt])
  @@index([locationId])
}

// ─────────────────────────────────────────────────────────────
// PRICING PLANS
// ─────────────────────────────────────────────────────────────

model PricingPlan {
  id              String          @id @default(cuid())
  name            String
  description     String?
  priceCents      Int
  billingInterval BillingInterval @default(MONATLICH)
  highlights      String[]
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)

  // Multi-Location: für welchen Standort gilt der Tarif?
  // null = Allgemein (gilt für alle Standorte)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]

  @@index([locationId, active])
}

// ─────────────────────────────────────────────────────────────
// LISTS & CAMPAIGNS
// ─────────────────────────────────────────────────────────────

model List {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  contacts  ContactList[]
  campaigns Campaign[]
}

model ContactList {
  contactId String
  listId    String
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
}

model Campaign {
  id          String    @id @default(cuid())
  listId      String
  list        List      @relation(fields: [listId], references: [id])
  subject     String
  bodyHtml    String
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("DRAFT")
  createdAt   DateTime  @default(now())

  events CampaignEvent[]
}

model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId  String
  event      String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([campaignId, event])
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model ContactEvent {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// FUNNELS
// ─────────────────────────────────────────────────────────────

model Funnel {
  id        String        @id @default(cuid())
  name      String
  trigger   FunnelTrigger
  active    Boolean       @default(true)
  autoStop  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  steps       FunnelStep[]
  enrollments FunnelEnrollment[]

  @@index([trigger, active])
}

model FunnelStep {
  id        String   @id @default(cuid())
  funnelId  String
  funnel    Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  orderNum  Int
  delayDays Int
  subject   String
  bodyHtml  String
  createdAt DateTime @default(now())

  events FunnelStepEvent[]

  @@unique([funnelId, orderNum])
  @@index([funnelId])
}

model FunnelEnrollment {
  id           String    @id @default(cuid())
  funnelId     String
  funnel       Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  events FunnelStepEvent[]

  @@unique([funnelId, contactId])
  @@index([completedAt, cancelledAt])
}

model FunnelStepEvent {
  id           String           @id @default(cuid())
  enrollmentId String
  enrollment   FunnelEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         FunnelStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  sentAt       DateTime         @default(now())

  @@unique([enrollmentId, stepId])
}

// ─────────────────────────────────────────────────────────────
// ADMIN
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
