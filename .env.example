# Datenbank (Postgres - Supabase)
# Im Supabase-Dashboard: Settings → Database → Connection string → URI mode
# WICHTIG: für Server-Deployments (Render) "Session" mode (Port 5432), nicht Pooler!
DATABASE_URL="postgresql://postgres.PROJEKT:DEIN_PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Resend (https://resend.com) - kostenloses Konto reicht zum Start
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Absender-Adresse
# Lokal/zum Testen geht "onboarding@resend.dev" (sendet nur an deine Resend-Mail)
# Produktiv: muss bei Resend als verifizierte Domain hinterlegt sein
MAIL_FROM="onboarding@resend.dev"

# Studio-Daten (für Mail-Templates und Footer)
STUDIO_NAME="Dein Fitnessstudio"
# Lokal: http://localhost:3000
# Produktiv: https://dein-studio.onrender.com (oder eigene Domain)
STUDIO_URL="http://localhost:3000"

# Geheim-Key für Tokens (lange, zufällige Zeichenfolge)
# Lokal kannst du irgendwas reinschreiben, produktiv: `openssl rand -base64 32`
TOKEN_SECRET="bitte-aendern-zu-einem-langen-zufallswert"
